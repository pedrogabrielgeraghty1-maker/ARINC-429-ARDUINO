PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ARINC_429_Arduino

# Configuración de la palabra ARINC completa; el operador solo envía el valor.
# Label octal, SDI y SSM fijos compartidos por todas las transmisiones.
ARINC_LABEL_OCTAL=203
ARINC_SDI=00
ARINC_SSM=00

# Unidades de valor por cuenta del campo de datos BNR.
# Ejemplo: 0.1 significa que el valor 12.3 se codifica como 123.
ARINC_DATA_RESOLUTION=1
